# Copy to frontend/.env for local Vite development.
# Every VITE_* value is public in the browser bundle. Do not put secrets here.

# Existing Vite /api proxy targets https://api.lvh.me:8443.
# No trailing slash: the admin client appends /grove-admin.
VITE_API_BASE_URL=/api
VITE_APP_DOMAIN=lvh.me

# Used when generating app links; Vite itself listens on 5173 in vite.config.js.
VITE_PORT=5173

# WebSocket port at api.lvh.me; protocol follows the current page (HTTPS -> WSS).
VITE_API_PORT=8443

# Call ICE configuration comes from the authenticated call-config endpoint.
# Configure STUN_URLS / TURN_URLS / TURN_SHARED_SECRET on the backend.

# Production example (set before building; the Vite dev proxy is not deployed):
# VITE_API_BASE_URL=https://api.groven.in/api
# VITE_APP_DOMAIN=groven.in
# VITE_PORT=
# VITE_API_PORT=
