# Backend and Docker Compose. Copy to .env at the repository root.
# Examples only: supply your own credentials. Never commit the populated .env.

# Django (development defaults)
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.lvh.me
FRONTEND_URL=https://lvh.me:5173
COOKIE_DOMAIN=.lvh.me

# PostgreSQL: service names match docker-compose.yml.
# For a backend running outside Docker, use your exposed database host/port.
DB_NAME=groven
DB_USER=groven
DB_PASSWORD=change-me-local-only
DB_HOST=postgres
DB_PORT=5432
CONN_MAX_AGE=60

# Shared by Celery, cache, and Channels. Outside Docker use your Redis host.
REDIS_URL=redis://redis:6379/0

# WebRTC relay (backend only). A separate TURN server must be provisioned.
STUN_URLS=stun:stun.l.google.com:19302
# Example: turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_URLS=
# Match the TURN server's use-auth-secret/static-auth-secret configuration.
TURN_SHARED_SECRET=
# Temporary credential lifetime in seconds (300–86400).
TURN_CREDENTIAL_TTL=3600

# SMTP: TLS is enabled in settings. EMAIL_HOST_USER is also the sender address.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=


# S3 file storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# Request-writing features: Gemini primary, Groq optional fallback.
GEMINI_API_KEY=
GROQ_API_KEY=

# Stripe: use test-mode credentials locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# Platform administrator (separate from provider/client accounts)
GROVE_ADMIN_EMAIL=admin@example.com
GROVE_ADMIN_PASSWORD=

# Before production: set DEBUG=False, replace all placeholders, and set
# ALLOWED_HOSTS, FRONTEND_URL, COOKIE_DOMAIN and service URLs for your deployment.

# Native device notifications for installed PWAs. Generate a stable VAPID pair:
# python manage.py generate_push_keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:notifications@example.com
